rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@bazaarloop.com' ||
        request.auth.token.email == 'jaorawalamufaddal7@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow delete: if isAdmin();
    }

    // Products catalog
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow create: if isSignedIn() && isValidId(productId) && request.resource.data.sellerId == request.auth.uid;
      allow update: if isSignedIn() && isValidId(productId) && (resource.data.sellerId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && isValidId(productId) && (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Orders
    match /orders/{orderId} {
      allow read: if isSignedIn() && (resource.data.buyerId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(orderId) && request.resource.data.buyerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
