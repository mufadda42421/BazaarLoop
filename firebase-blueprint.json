{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered buyer or merchant profile with settings and banking details",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "format": "email", "maxLength": 150 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "avatarUrl": { "type": "string", "maxLength": 1000 },
        "city": { "type": "string", "maxLength": 100 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "email"]
    },
    "Product": {
      "title": "Product",
      "description": "100% brand-new retail product listing",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerName": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 200 },
        "description": { "type": "string", "maxLength": 3000 },
        "price": { "type": "number" },
        "currency": { "type": "string", "maxLength": 10 },
        "category": { "type": "string", "maxLength": 50 },
        "quantity": { "type": "number" },
        "condition": { "type": "string", "enum": ["new"] },
        "status": { "type": "string", "enum": ["active", "draft", "paused", "sold", "out_of_stock"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sellerId", "title", "price", "category", "condition"]
    },
    "Order": {
      "title": "Order",
      "description": "E-commerce order record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 50 },
        "buyerId": { "type": "string", "maxLength": 128 },
        "buyerName": { "type": "string", "maxLength": 100 },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["placed", "processing", "shipped", "delivered"] },
        "paymentMethod": { "type": "string", "enum": ["upi", "gpay", "apple_pay", "paypal", "card", "cod"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderNumber", "buyerId", "total", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profile store"
    },
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Retail marketplace products"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders"
    }
  }
}
